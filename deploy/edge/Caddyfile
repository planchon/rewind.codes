# The edge: the only published port. Every node answers every route (it reaches the owner of a
# run's partition through the node link), so each request goes to the next node; a node that is
# down or starting again leaves it to the other.
{
	admin off
	auto_https off
}

:8080 {
	# Event streams: no buffering.
	reverse_proxy node-1-net:8080 node-2-net:8080 {
		lb_policy round_robin
		lb_try_duration 5s
		flush_interval -1
	}
}
