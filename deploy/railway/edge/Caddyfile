# The edge of the Railway deployment (deploy/railway/README.md), behind api.rewind.codes: everything
# goes to the api, except the requests that run tests, and therefore model-written code, on the
# workers (the api role answers them with 503): `POST /v1/test`, `POST /v1/workflows` and
# `POST /v1/runs/{id}/fork`. Both are on Railway's private network.
{
	admin off
	auto_https off
}

:8080 {
	@runs_tests {
		method POST
		path_regexp ^/v1/(test|workflows|runs/[^/]+/fork)$
	}
	handle @runs_tests {
		reverse_proxy worker.railway.internal:8080 {
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
	handle {
		# The api sleeps when idle: while it starts again, connections are refused, and retried
		# here for up to 30 s instead of failing. Event streams and long polls: no buffering.
		reverse_proxy api.railway.internal:8080 {
			flush_interval -1
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}
}
