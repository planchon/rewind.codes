# The edge of the Railway deployment (deploy/railway/README.md), behind api.rewind.codes: every
# request goes to the node service, on Railway's private network, which answers every route.
{
	admin off
	auto_https off
}

:8080 {
	# While a node starts (a deploy), connections are refused, and retried here for up to 30 s
	# instead of failing. Event streams: no buffering.
	reverse_proxy node.railway.internal:8080 {
		flush_interval -1
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
