# Copy to .env. The hosted service: https://api.rewind.codes, with a key made in the dashboard
# (app.rewind.codes, Organization → API keys). A server of your own: its URL and one of its keys.
REWIND_URL=https://api.rewind.codes
REWIND_API_KEY=rewind_sk_...

# For agent/anthropic.ts and agent/openai.ts only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# For webhooks/index.ts: the secret its subscription answered with, whsec_…
REWIND_WEBHOOK_SECRET=
