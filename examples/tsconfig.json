{
  // The harness code of the examples, run by Node as it is (type stripping). The workflows' code
  // under */workflows/ is not part of it: it runs in Rewind's sandbox, which type-checks it against
  // its action set when a run starts.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "*/workflows/**"]
}
