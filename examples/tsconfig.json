{
  // The harness code of the examples, run by Node as it is (type stripping). The scripts under
  // */scripts/ are not part of it: they run in Rewind's sandbox, which type-checks them against
  // their toolset when a run starts.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "**/scripts/**"]
}
