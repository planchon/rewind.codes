{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!.vercel", "!src/generated", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noDescendingSpecificity": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-router": {
                "importNames": ["Link", "NavLink", "Navigate", "useNavigate"],
                "message": "Use the ones of src/app/namespace.tsx: they keep the namespace filter (?ns=)."
              }
            }
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/namespace.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
