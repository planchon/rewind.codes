{
  "description": "The server refuses expired credentials: the call is parked, the run waits, and once the harness renews the credentials the call is sent again and the script gets its answer.",
  "input": { "customer": "c-7" },
  "actions": {
    "crm.lookup": {
      "$sequence": [{ "$unauthorized": "the token expired" }, { "name": "Ada" }]
    }
  },
  "steps": [
    { "advance": "1d" },
    { "credentials": { "crm": { "Authorization": "Bearer renewed" } } }
  ],
  "expect": {
    "status": "completed",
    "output": { "name": "Ada" },
    "calls": { "crm.lookup": 1 },
    "events": ["run_started", "schedule_call", "call_completed", "complete_run"]
  }
}
