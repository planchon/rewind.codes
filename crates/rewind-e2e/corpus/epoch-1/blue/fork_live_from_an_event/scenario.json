{
  "description": "A fork forced live at an event calls the action again from there, although its commands still match the source's; the results before that event are reused.",
  "actions": {
    "weather.forecast": {
      "$sequence": [
        {
          "sky": "sunny"
        },
        {
          "sky": "unavailable"
        },
        {
          "sky": "snow"
        }
      ]
    }
  },
  "fork": {
    "code": "workflow.ts",
    "at": 3
  },
  "expect": {
    "status": "completed",
    "output": {
      "paris": "sunny",
      "oslo": "snow"
    },
    "dispatched": {
      "weather.forecast": 3
    }
  }
}
