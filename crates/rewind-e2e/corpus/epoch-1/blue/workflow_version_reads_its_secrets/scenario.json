{
  "description": "A workflow's version uses the namespace's crm: the run a code starts reads the secret of its own namespace, though the code that started it named none.",
  "live": true,
  "mcp_servers": [
    "crm"
  ],
  "auth": {
    "crm": "secret"
  },
  "output_schemas": {
    "crm.lookup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "workflows": {
    "triage": {
      "code": "triage.ts",
      "input": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "string"
          }
        },
        "required": [
          "customer"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "secrets": {
        "crm": "ns/crm"
      }
    }
  },
  "put_secrets": {
    "ns/crm": "crm-token",
    "org/crm": "org-token"
  },
  "actions": {
    "crm.lookup": {
      "name": "Ada"
    }
  },
  "expect": {
    "status": "completed",
    "output": {
      "name": "Ada"
    },
    "children": [
      "completed"
    ],
    "auth": [
      "crm-token"
    ]
  }
}
