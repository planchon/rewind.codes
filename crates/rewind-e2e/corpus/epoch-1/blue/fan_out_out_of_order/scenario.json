{
  "description": "Promise.all over three calls whose results arrive in reverse order: seq is assigned in emission order, and the replay delivers the completions in the recorded order.",
  "input": {
    "repo": "acme/api"
  },
  "actions": {
    "github.get_issue": {
      "$echo": true
    }
  },
  "action_order": "reversed",
  "expect": {
    "status": "completed",
    "output": {
      "numbers": [
        1,
        2,
        3
      ]
    },
    "calls": {
      "github.get_issue": 3
    },
    "events": [
      "run_started",
      "schedule_call",
      "schedule_call",
      "schedule_call",
      "call_completed",
      "call_completed",
      "call_completed",
      "complete_run"
    ]
  }
}
