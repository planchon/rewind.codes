{
  "description": "A script starts a run of a workflow per repository, approves each with a signal and adds up their results: the runs really run, and their ends come back to the script as signals.",
  "live": true,
  "input": { "repos": ["acme/api", "acme/web"] },
  "tools": {
    "github.list_issues": [{ "number": 1 }, { "number": 2 }],
    "github.close_issue": { "$echo": true }
  },
  "workflows": {
    "triage": {
      "description": "Triage the stale issues of a repository, after approval.",
      "script": "triage.ts",
      "input": { "type": "object", "properties": { "repo": { "type": "string" } }, "required": ["repo"] },
      "output": { "type": "object", "properties": { "closed": { "type": "integer" } }, "required": ["closed"] },
      "signals": { "approval": { "type": "object", "properties": { "close": { "type": "boolean" } }, "required": ["close"] } }
    }
  },
  "expect": {
    "status": "completed",
    "output": { "closed": 4 },
    "calls": { "workflows.triage.start": 2, "workflows.triage.signal": 2 },
    "children": ["completed", "completed"]
  }
}
