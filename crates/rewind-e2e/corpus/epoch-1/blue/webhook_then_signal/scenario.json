{
  "description": "webhook(name) is a recorded call of the built-in webhook action, returning { url }; what is posted to that URL arrives as the signal of that name.",
  "input": {
    "repo": "acme/api"
  },
  "actions": {
    "webhook": {
      "url": "https://rewind.example.com/hooks/whk_8f3a"
    },
    "github.create_webhook": {
      "$echo": true
    }
  },
  "steps": [
    {
      "signal": {
        "name": "pr_merged",
        "payload": { "pr": 42 },
        "key": "delivery-1"
      }
    }
  ],
  "expect": {
    "status": "completed",
    "output": {
      "url": "https://rewind.example.com/hooks/whk_8f3a",
      "merged": 42
    },
    "calls": {
      "github.create_webhook": 1,
      "webhook": 1
    }
  }
}
