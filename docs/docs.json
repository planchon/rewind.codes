{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rewind",
  "description": "Rewind runs the TypeScript workflows your model writes to call your actions, in a deterministic sandbox that records every step in its history: runs wait for days, survive crashes, and replay identically.",
  "colors": {
    "primary": "#059669",
    "light": "#34D399",
    "dark": "#047857"
  },
  "fonts": {
    "family": "IBM Plex Sans"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://rewind.codes"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Introduction",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "why-rewind", "quickstart", "claude"]
          },
          {
            "group": "How it works",
            "pages": [
              "concepts/how-it-works",
              "concepts/history",
              "concepts/sandbox",
              "concepts/actions",
              "concepts/workflows",
              "concepts/end-users",
              "glossary"
            ]
          },
          {
            "group": "Run Rewind",
            "pages": ["self-hosting"]
          }
        ]
      },
      {
        "tab": "SDK",
        "icon": "code",
        "groups": [
          {
            "group": "Get started",
            "pages": ["sdk/overview", "sdk/examples"]
          },
          {
            "group": "Build a harness",
            "pages": [
              "sdk/action-sets",
              "sdk/secrets",
              "sdk/signed-calls",
              "sdk/agent-tools",
              "sdk/runs",
              "sdk/harness-actions",
              "sdk/human-in-the-loop",
              "sdk/end-users",
              "sdk/webhooks",
              "sdk/testing"
            ]
          },
          {
            "group": "Workflows",
            "pages": ["sdk/workflows", "sdk/workflow-reference"]
          },
          {
            "group": "Reference",
            "pages": ["sdk/errors", "sdk/reference", "sdk/cli"]
          }
        ]
      },
      {
        "tab": "Dashboard",
        "icon": "layout-dashboard",
        "groups": [
          {
            "group": "Get started",
            "pages": ["dashboard/introduction"]
          },
          {
            "group": "Runs",
            "pages": ["dashboard/overview", "dashboard/runs", "dashboard/query-language", "dashboard/run"]
          },
          {
            "group": "Workflows, actions and end users",
            "pages": ["dashboard/workflows", "dashboard/actions", "dashboard/namespaces", "dashboard/secrets"]
          },
          {
            "group": "Your organization",
            "pages": ["dashboard/organization"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/planchon/rewind.codes",
          "icon": "github"
        },
        {
          "anchor": "Examples",
          "href": "https://github.com/planchon/rewind.codes/tree/main/examples",
          "icon": "flask-conical"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/concepts/journal", "destination": "/concepts/history" },
    { "source": "/concepts/tools", "destination": "/concepts/actions" },
    { "source": "/sdk/toolsets", "destination": "/sdk/action-sets" },
    { "source": "/sdk/host-tools", "destination": "/sdk/harness-actions" },
    { "source": "/sdk/scripts", "destination": "/sdk/workflows" },
    { "source": "/sdk/script-reference", "destination": "/sdk/workflow-reference" },
    { "source": "/dashboard/observability", "destination": "/dashboard/runs" },
    { "source": "/dashboard/scripts", "destination": "/dashboard/workflows" },
    { "source": "/dashboard/testing", "destination": "/dashboard/workflows" },
    { "source": "/dashboard/tools", "destination": "/dashboard/actions" }
  ],
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "rewind.codes",
        "href": "https://rewind.codes"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.rewind.codes"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "cursor", "vscode"]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.rewind.codes"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/planchon/rewind.codes"
    }
  }
}
