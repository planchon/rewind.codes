{
  "base": "http://localhost:5391",
  "widths": [1280],
  "themes": ["light", "dark"],
  "shots": [
    { "name": "observability", "path": "/observability" },
    {
      "name": "observability-stuck",
      "path": "/observability",
      "steps": [{ "scroll": 600 }],
      "corners": ".table-wrap thead"
    },
    {
      "name": "observability-sideways",
      "path": "/observability",
      "themes": ["light"],
      "steps": [{ "scroll": 600 }, { "scrollX": { "selector": ".table-wrap", "to": "end" } }]
    },
    {
      "name": "observability-status-menu",
      "path": "/observability",
      "themes": ["light"],
      "steps": [{ "click": "th button:has-text('Status')" }]
    },
    { "name": "observability-narrow", "path": "/observability", "widths": [1100], "themes": ["light"] },
    { "name": "namespaces", "path": "/namespaces" },
    { "name": "scripts", "path": "/scripts" }
  ]
}
