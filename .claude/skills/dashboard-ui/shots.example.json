{
  "base": "http://localhost:5391",
  "widths": [1280],
  "themes": ["light", "dark"],
  "shots": [
    { "name": "runs", "path": "/runs" },
    {
      "name": "runs-stuck",
      "path": "/runs",
      "steps": [{ "scroll": 600 }],
      "corners": ".table-wrap thead"
    },
    {
      "name": "runs-sideways",
      "path": "/runs",
      "themes": ["light"],
      "steps": [{ "scroll": 600 }, { "scrollX": { "selector": ".table-wrap", "to": "end" } }]
    },
    {
      "name": "runs-status-menu",
      "path": "/runs",
      "themes": ["light"],
      "steps": [{ "click": "th button:has-text('Status')" }]
    },
    { "name": "runs-narrow", "path": "/runs", "widths": [1100], "themes": ["light"] },
    { "name": "namespaces", "path": "/namespaces" },
    { "name": "workflows", "path": "/workflows" }
  ]
}
